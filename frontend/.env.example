# Which public network the dashboard and Bread play on: testnet (default) | mainnet | devnet | localhost.
# `cargo run --bin deploy_round` writes this file (.env.local) after a round is deployed.
VITE_MIDEN_NETWORK=testnet

# RPC node: an SDK shorthand (devnet | testnet | localhost) or a full URL. Mainnet has no
# shorthand; unset falls back to https://rpc.cedar.miden.io when VITE_MIDEN_NETWORK=mainnet.
# VITE_MIDEN_RPC_URL=testnet

# Prover: devnet | testnet | local | https://your-prover-url (mainnet: https://tx-prover.cedar.miden.io)
# VITE_MIDEN_PROVER=testnet

# Block explorer base URL (default per network; mainnet: https://explorer.cedar.miden.io)
# VITE_MIDEN_EXPLORER_URL=https://testnet.midenscan.com

# Public faucet. Defaults to the testnet faucet on testnet; empty on mainnet, which has none.
# VITE_MIDEN_FAUCET_URL=https://faucet-api.testnet.miden.io

# The deployed Fomo3D game account (hex). Unset shows the preview dashboard.
# VITE_MIDEN_GAME_ADDRESS=
